[Unit]
Description=HorsesDontStop PAPER opening-equity collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hds-equity
Group=hds-equity
WorkingDirectory=/opt/horsesdontstop
EnvironmentFile=/etc/horsesdontstop/equity.env
ExecStart=/opt/horsesdontstop/.venv/bin/python -m bot.paper_opening_equity_daemon --interval-seconds 15
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
